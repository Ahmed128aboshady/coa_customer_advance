<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_settle_wizard_form" model="ir.ui.view">
        <field name="name">advance.settle.wizard.form</field>
        <field name="model">advance.settle.wizard</field>
        <field name="arch" type="xml">
            <form string="تسوية الدفعة المقدمة">
                <group>
                    <group>
                        <field name="invoice_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="invoice_residual"/>
                        <field name="total_to_settle"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="payment_id" readonly="1" force_save="1"/>
                        <field name="available_amount" readonly="1" force_save="1"/>
                        <field name="amount_to_settle"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_settle" type="object" string="تسوية"
                            class="btn-primary"/>
                    <button special="cancel" string="إلغاء" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
