<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_advance" model="ir.ui.view">
        <field name="name">account.payment.form.advance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="payment_type" position="after">
                <field name="is_customer_advance"
                       invisible="payment_type != 'inbound' or partner_type != 'customer'"/>
                <field name="advance_residual"
                       invisible="not is_customer_advance"/>
            </field>
        </field>
    </record>
</odoo>
