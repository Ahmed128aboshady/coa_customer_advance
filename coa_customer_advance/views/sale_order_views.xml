<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_advance" model="ir.ui.view">
        <field name="name">sale.order.form.advance</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_advance_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="advance_payment_count == 0">
                    <field name="advance_payment_count" widget="statinfo"
                           string="دفعات مقدمة"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
