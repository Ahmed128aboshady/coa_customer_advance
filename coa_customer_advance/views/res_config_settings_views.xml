<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_advance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.advance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting string="Customer Advance Account"
                         help="حساب الالتزام لترحيل الدفعات المقدمة من العملاء">
                    <field name="customer_advance_account_id"/>
                    <field name="customer_advance_journal_id"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
